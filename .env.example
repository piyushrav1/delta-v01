# ==============================================================================
# DELTA INDIA TERMINAL — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Trading Environment & Security Mode (FAIL-CLOSED)
# Options: BACKTEST | PAPER | TESTNET | LIVE_MANUAL | LIVE_AUTO
# Default: TESTNET (Blocks all real-money live order routing)
# ------------------------------------------------------------------------------
TRADING_ENVIRONMENT=TESTNET

# Explicit authorization required ONLY if TRADING_ENVIRONMENT=LIVE_AUTO
LIVE_AUTO_AUTHORIZED=false

# Phased Capital Rollout Stage: MICRO_LOT | CONSERVATIVE | STANDARD
# MICRO_LOT: Max 1 lot per order, Strategy A/F only, hard stop at $20.00 loss
LIVE_ROLLOUT_STAGE=MICRO_LOT

# ------------------------------------------------------------------------------
# 2. Database & State Persistence
# SQLite in WAL mode by default; can point to PostgreSQL if needed
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/delta_terminal.sqlite

# ------------------------------------------------------------------------------
# 3. Delta Exchange India API Endpoints
# Testnet: https://cdn-ind.testnet.deltaex.org
# Live:    https://api.india.delta.exchange
# Fallback: https://api.deltaexchange.in
# ------------------------------------------------------------------------------
DELTA_API_BASE_URL=https://cdn-ind.testnet.deltaex.org

# Account 1 (Primary / Main Account)
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_ACCOUNT_MAIN_LABEL=Main
DELTA_ACCOUNT_MAIN_ENVIRONMENT=TESTNET

# Additional Accounts (Uncomment to enable multi-account trading)
# DELTA_ACCOUNT_2_KEY=
# DELTA_ACCOUNT_2_SECRET=
# DELTA_ACCOUNT_2_LABEL=Testnet Secondary
# DELTA_ACCOUNT_2_ENVIRONMENT=TESTNET

# ------------------------------------------------------------------------------
# 4. Central Risk Management Limits
# ------------------------------------------------------------------------------
MAX_DAILY_LOSS_USD=500.0
MAX_DAILY_LOSS_PCT=0.02
MAX_RISK_PER_TRADE_PCT=0.01
MAX_OPEN_POSITIONS=5
MAX_LEVERAGE=10.0
MAX_SLIPPAGE_PCT=0.005
QUOTE_FRESHNESS_MAX_MS=3000.0
HEARTBEAT_TIMEOUT_SEC=10.0
CONSECUTIVE_REJECTION_LIMIT=3

# ------------------------------------------------------------------------------
# 5. Terminal Web Server & Security Gate
# ------------------------------------------------------------------------------
TERMINAL_PASSWORD=change-this-password-now
TERMINAL_HOST=127.0.0.1
PORT=5050

# ------------------------------------------------------------------------------
# 6. Telegram Notifications (Optional — leave blank to disable)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 7. Options Anomaly Scanner Thresholds
# ------------------------------------------------------------------------------
MAX_ARBITRAGE_SPREAD=200
STOP_LOSS_PERCENT=20
MIN_BID_ASK_GAP_FAR_OTM=30
MIN_BID_ASK_GAP_NEAR_ATM=70
MIN_TRADE_GAP=70
