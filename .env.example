# Delta Exchange India API — get keys from Delta -> API Management.
# Needs Trade permission for live orders (read-only keys can only view data).
DELTA_API_BASE_URL="https://api.india.delta.exchange"

# Account 1 (Primary / Main Account)
DELTA_API_KEY=
DELTA_API_SECRET=
# Custom display label for Account 1 (defaults to "Main" if left blank)
DELTA_ACCOUNT_MAIN_LABEL=Main

# Additional Trading Accounts (Uncomment to enable extra accounts)
# Account 2
# DELTA_ACCOUNT_2_KEY=
# DELTA_ACCOUNT_2_SECRET=
# DELTA_ACCOUNT_2_LABEL=Account 2

# Account 3
# DELTA_ACCOUNT_3_KEY=
# DELTA_ACCOUNT_3_SECRET=
# DELTA_ACCOUNT_3_LABEL=Account 3

# Account 4
# DELTA_ACCOUNT_4_KEY=
# DELTA_ACCOUNT_4_SECRET=
# DELTA_ACCOUNT_4_LABEL=Account 4

# Telegram alerts (optional — leave blank to disable).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Terminal login password (REQUIRED — pages refuse to load without it).
TERMINAL_PASSWORD=change-this-password-now

# Bind address & port (127.0.0.1:5050 prevents conflicts with old PWA service worker caches)
TERMINAL_HOST=127.0.0.1
PORT=5050

# Anomaly thresholds
MAX_ARBITRAGE_SPREAD=200
STOP_LOSS_PERCENT=20
MIN_BID_ASK_GAP_FAR_OTM=30
MIN_BID_ASK_GAP_NEAR_ATM=70
MIN_TRADE_GAP=70
